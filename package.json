{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "description": "Meridian — self-hosted personal finance ledger. Know exactly where you stand.",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx bin/migrate.ts up",
    "db:migrate:down": "tsx bin/migrate.ts down",
    "db:seed": "tsx bin/seed.ts",
    "admin:promote": "tsx bin/promote-admin.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev --port 8787 --test-scheduled",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:cloud": "vitest run --config vitest.cloud.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@opennextjs/cloudflare": "^1.20.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.34.0",
    "motion": "^13.2.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.31.0",
    "eslint-config-next": "^16.3.8",
    "miniflare": "^5.20261001.0-alpha",
    "prettier": "^3.6.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22"
  }
}
